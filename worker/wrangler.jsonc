{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dark-aurelien-poke",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:8765,http://localhost:8765,https://jecodelesoir.github.io"
  },
  "ratelimits": [
    {
      "name": "POKE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 1,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": ["DISCORD_WEBHOOK_URL", "YOUTUBE_API_KEY", "TURNSTILE_SECRET_KEY"]
  }
}
