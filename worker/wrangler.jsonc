{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dark-aurelien-poke",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:8765,http://localhost:8765,https://jecodelesoir.github.io",
    "LASTFM_USERNAME": "aurelien97480"
  },
  "d1_databases": [
    {
      "binding": "VISITORS_DB",
      "database_name": "dark-aurelien-visitors",
      "database_id": "d2096f9c-d561-4fca-a12b-8eee8db332eb"
    }
  ],
  "ratelimits": [
    {
      "name": "POKE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 1,
        "period": 60
      }
    },
    {
      "name": "APP_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": ["DISCORD_WEBHOOK_URL", "TURNSTILE_SECRET_KEY", "VISITOR_HASH_SALT", "APP_API_TOKEN", "LASTFM_API_KEY"]
  }
}
